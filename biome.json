{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/assets/skeleton.html", "!test-results", "!playwright-report"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noParameterAssign": "error", "useTemplate": "off" },
      "complexity": { "noForEach": "off" }
    }
  }
}
